#!/usr/bin/env bash
# claude-task — run the Claude Code CLI as a delegated worker, archiving every run.
#
# Usage:
#   claude-task run    [opts] (-p TEXT | -f FILE | stdin)    start a new task
#   claude-task resume RUN_DIR [opts] (-p | -f | stdin)      follow up in the same Claude session
#   claude-task review [opts] [--uncommitted | --base BR | --commit SHA] [-p | -f]
#   claude-task peek   RUN_DIR [N]                           summarize the last N events
#   claude-task watch  RUN_DIR [INTERVAL_S=120] [STALL_S=600] HB/STALL/DONE lines until the run ends
#   claude-task ls     [N]                                   list recent runs
#
# Options:
#   -n NAME      run name (default: task)
#   -t TIER      haiku | sonnet | opus (default: sonnet)
#   -m MODEL     explicit model id (overrides tier)
#   -e EFFORT    low | medium | high | xhigh | max (haiku: unset, sonnet: medium, opus: high)
#   -s MODE      ro | rw | full = default | acceptEdits | bypassPermissions (default: ro)
#   -C DIR       working root (default: $PWD)
#   --net        unsupported: no confirmed unrestricted sandbox network setting
#   --add-dir D  extra accessible directory (repeatable)
#   --raw        do not append the handoff contract to the prompt
#
# ro: read files and run read-only commands; cannot run tests.
# rw: confined Bash writes/tests; Linux requires bwrap and socat; network blocked.
#
# Runs live in ${AGENT_RUNS_ROOT:-$HOME/.agent-runs}/<stamp>-claude-<name>/:
#   prompt.md  events.jsonl  stderr.log  last.md  meta.env  pid  exit_code
# Read-only reviewers cannot run test suites that write temporary files.
set -uo pipefail

RUNS_ROOT="${AGENT_RUNS_ROOT:-$HOME/.agent-runs}"
REPO_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"

die() { echo "claude-task: $*" >&2; exit 2; }

tier_model() {
  case "$1" in
    haiku | sonnet | opus) echo "$1" ;;
    *) die "unknown tier '$1' (haiku|sonnet|opus)" ;;
  esac
}

tier_effort() {
  case "$1" in
    haiku) echo "" ;;
    sonnet) echo medium ;;
    opus) echo high ;;
  esac
}

sandbox_of() {
  case "$1" in
    ro) echo default ;;
    rw) echo acceptEdits ;;
    full) echo bypassPermissions ;;
    *) die "unknown sandbox '$1' (ro|rw|full)" ;;
  esac
}

read -r -d '' WORK_CONTRACT <<'EOF'

---
## Handoff contract (from the orchestrating agent)
- You are a worker. Do not delegate to other agents and do not run codex-task or claude-task.
- You are a delegated worker. The orchestrator only reads your final message, so put everything it needs there.
- Stay inside the scope described above. If the task is ambiguous or you are blocked, stop and say so instead of guessing.
- Write code a human reviewer can read quickly: clear names, small functions, match the surrounding style, comments only where intent is non-obvious.
- Do not commit, push, or touch files outside the task scope.
- End your final message with exactly these sections:
  STATUS: done | partial | blocked
  CHANGES: each file touched + one-line purpose (or "none")
  VERIFICATION: commands you ran and their results; say explicitly what you did NOT verify
  RISKS: assumptions, uncertainties, suggested follow-ups
EOF

read -r -d '' REVIEW_CONTRACT <<'EOF'

---
## Reporting format (from the orchestrating agent)
Report only defects you can tie to a concrete failure. For each finding give:
severity (high|medium|low), file:line, the defect in one sentence, and a concrete input/state that triggers it.
If nothing survives scrutiny, say "NO FINDINGS". Do not modify any files.
EOF

# ---------- event summarizer (shared by run/peek/watch) ----------
summarize() {  # summarize EVENTS_FILE MODE [N]
  local file="$1" mode="$2"; shift 2
  python3 "$REPO_ROOT/lib/agent_events.py" "$mode" claude "$file" "$@"
}

fmt_secs() { printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); }

meta_get() { grep -m1 "^$2=" "$1/meta.env" 2>/dev/null | cut -d= -f2-; }

# ---------- run / resume / review ----------
launch() {
  local kind="$1"; shift
  local name=task tier=sonnet model="" effort="" sbx=ro cwd="$PWD" net=0 raw=0
  local prompt="" prompt_file="" have_prompt=0 parent="" thread="" use_tier_effort=1
  local -a add_dirs=() review_target=()

  if [[ "$kind" == resume ]]; then
    parent="${1:-}"; shift || true
    [[ -f "$parent/meta.env" ]] || die "resume: '$parent' is not a run directory"
    thread="$(meta_get "$parent" THREAD)"
    [[ -n "$thread" ]] || die "resume: no thread id recorded in $parent"
    name="$(meta_get "$parent" NAME)-followup"
    model="$(meta_get "$parent" MODEL)"; effort="$(meta_get "$parent" EFFORT)"
    sbx="$(meta_get "$parent" SANDBOX_SHORT)"; cwd="$(meta_get "$parent" CWD)"
    net="$(meta_get "$parent" NET)"
    use_tier_effort=0
  fi

  while (($#)); do
    case "$1" in
      -n) name="$2"; shift 2 ;;
      -t) tier="$2"; model=""; effort=""; use_tier_effort=1; shift 2 ;;
      -m) model="$2"; shift 2 ;;
      -e) effort="$2"; shift 2 ;;
      -s) sbx="$2"; shift 2 ;;
      -C) cwd="$2"; shift 2 ;;
      -p) prompt="$2"; have_prompt=1; shift 2 ;;
      -f) prompt_file="$2"; have_prompt=1; shift 2 ;;
      --net) net=1; shift ;;
      --raw) raw=1; shift ;;
      --add-dir) add_dirs+=(--add-dir "$2"); shift 2 ;;
      --uncommitted) review_target=(--uncommitted); shift ;;
      --base) review_target=(--base "$2"); shift 2 ;;
      --commit) review_target=(--commit "$2"); shift 2 ;;
      -h | --help) sed -n '2,/^set /{ /^set /!p; }' "$0"; exit 0 ;;
      *) die "unknown option '$1'" ;;
    esac
  done

  [[ -n "$model" ]] || model="$(tier_model "$tier")" || return 2
  if [[ -z "$effort" ]] && ((use_tier_effort)); then effort="$(tier_effort "$tier")"; fi
  ((net)) && die "--net is not supported: no confirmed unrestricted sandbox network setting; use -s full if unrestricted access is intended"
  [[ "$kind" == review ]] && sbx=ro
  local sandbox; sandbox="$(sandbox_of "$sbx")" || return 2
  if [[ "$sbx" == rw && "$(uname -s)" == Linux ]]; then
    command -v bwrap >/dev/null && command -v socat >/dev/null || die "rw sandbox requires bwrap and socat on PATH; install with: sudo apt-get install bubblewrap socat"
    bwrap --ro-bind / / --unshare-user --unshare-pid --unshare-net --proc /proc --dev /dev -- true >/dev/null 2>&1 || die "rw sandbox cannot start bubblewrap; refusing unsandboxed fallback"
  fi
  cwd="$(cd "$cwd" 2>/dev/null && pwd)" || die "working dir does not exist"

  if [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || die "prompt file '$prompt_file' not found"
    prompt="$(cat "$prompt_file")"
  elif ((!have_prompt)) && [[ ! -t 0 ]]; then
    prompt="$(cat)"
  fi
  if [[ -z "${prompt//[[:space:]]/}" && "$kind" != review ]]; then
    die "empty prompt (use -p TEXT, -f FILE, or pipe it on stdin)"
  fi
  if [[ "$kind" == review ]]; then
    # Claude reviews are ordinary read-only runs with the target in the prompt.
    ((${#review_target[@]})) || review_target=(--uncommitted)
    local scope
    case "${review_target[0]}" in
      --uncommitted) scope='the uncommitted changes in this repository (staged, unstaged and untracked; start from `git status` and `git diff HEAD`)' ;;
      --base) scope="the changes on the current branch relative to ${review_target[1]} (\`git diff ${review_target[1]}...HEAD\`)" ;;
      --commit) scope="the changes introduced by commit ${review_target[1]} (\`git show ${review_target[1]}\`)" ;;
    esac
    prompt="Review $scope."$'\n\n'"$prompt"
  fi

  if ((!raw)) && [[ -n "${prompt//[[:space:]]/}" ]]; then
    if [[ "$kind" == review ]]; then prompt+="$REVIEW_CONTRACT"; else prompt+="$WORK_CONTRACT"; fi
  fi

  local value
  for value in "$name" "$model" "$effort" "$sbx" "$cwd" "$parent" "$thread"; do
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "metadata values cannot contain newlines"
  done
  mkdir -p "$RUNS_ROOT" || die "cannot create runs root"
  local base="$RUNS_ROOT/$(date +%Y%m%d-%H%M%S)-claude-${name//[^A-Za-z0-9._-]/_}" run attempt=0
  while :; do
    run="$base"; ((attempt)) && run="$base-$$-$attempt"
    mkdir -- "$run" 2>/dev/null && break
    [[ -e "$run" ]] || die "cannot create run directory '$run'"
    ((attempt+=1))
  done
  printf '%s\n' "$prompt" > "$run/prompt.md"

  local start; start="$(date +%s)"
  {
    echo "NAME=$name"; echo "KIND=$kind"; echo "AGENT=claude"; echo "MODEL=$model"; echo "EFFORT=$effort"
    echo "SANDBOX=$sandbox"; echo "SANDBOX_SHORT=$sbx"; echo "NET=$net"; echo "CWD=$cwd"
    echo "PARENT=$parent"; echo "START=$start"
  } > "$run/meta.env"

  local -a cmd=(claude -p --output-format stream-json --verbose --model "$model")
  [[ -n "$effort" ]] && cmd+=(--effort "$effort")
  cmd+=(--permission-mode "$sandbox")
  local denied=Task,Agent
  if [[ "$sbx" == ro ]]; then denied+=,Edit,Write,NotebookEdit; fi
  cmd+=(--disallowedTools "$denied")
  if [[ "$sbx" != full ]]; then
    cmd+=(--setting-sources "" --permission-prompts none --strict-mcp-config --mcp-config '{"mcpServers":{}}')
    if [[ "$sbx" == ro ]]; then
      cmd+=(--settings '{"sandbox":{"enabled":false}}')
    else
      cmd+=(--settings '{"sandbox":{"enabled":true,"autoAllowBashIfSandboxed":true,"failIfUnavailable":true,"allowUnsandboxedCommands":false}}')
    fi
  fi
  cmd+=("${add_dirs[@]}")
  [[ "$kind" == resume ]] && cmd+=(--resume "$thread")

  echo "claude-task: $kind '$name' -> $run ($model${effort:+/$effort}, $sbx ($sandbox))" >&2
  python3 "$REPO_ROOT/lib/agent_events.py" worker "$cwd" "${cmd[@]}" < "$run/prompt.md" > "$run/events.jsonl" 2> "$run/stderr.log" &
  local pid=$! interrupted=0 rc
  # Keep watch attached through archive finalization.
  echo "$$" > "$run/pid"
  trap 'interrupted=130; kill -INT "$pid" 2>/dev/null || true' INT
  trap 'interrupted=143; kill -TERM "$pid" 2>/dev/null || true' TERM
  trap 'interrupted=129; kill -HUP "$pid" 2>/dev/null || true' HUP
  wait "$pid"; rc=$?
  if ((interrupted)); then wait "$pid"; rc=$interrupted; fi
  trap '' INT TERM HUP

  local end; end="$(date +%s)"
  echo "END=$end" >> "$run/meta.env"
  echo "EXIT=$rc" >> "$run/meta.env"
  summarize "$run/events.jsonl" meta >> "$run/meta.env"
  summarize "$run/events.jsonl" final > "$run/last.md"
  [[ -e "$run/last.md" ]] || : > "$run/last.md"
  printf '%s\n' "$rc" > "$run/exit_code.tmp"
  mv -- "$run/exit_code.tmp" "$run/exit_code"
  trap - INT TERM HUP

  echo "RUN     $run"
  echo "MODEL   $model${effort:+/$effort}   SANDBOX $sbx ($sandbox)$( ((net)) && echo ' +net')   CWD $cwd"
  echo "EXIT    $rc   TIME $(fmt_secs $((end - start)))   THREAD $(meta_get "$run" THREAD)"
  echo "TOKENS  in=$(meta_get "$run" TOKENS_IN) cached=$(meta_get "$run" TOKENS_CACHED) out=$(meta_get "$run" TOKENS_OUT) reasoning=$(meta_get "$run" TOKENS_REASONING)"
  if ((rc != 0)); then
    echo "----- stderr (tail) -----"; tail -n 20 "$run/stderr.log"
  fi
  if git -C "$cwd" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "----- git status ($cwd) -----"
    git -C "$cwd" status --short | head -n 40
  fi
  echo "----- final message -----"
  if [[ -s "$run/last.md" ]]; then
    head -n 200 "$run/last.md"
    (($(wc -l < "$run/last.md") > 200)) && echo "... (truncated; full text in $run/last.md)"
  else
    echo "(no final message)"
  fi
  return "$rc"
}

# ---------- peek / watch / ls ----------
peek() {
  local run="${1:?usage: claude-task peek RUN_DIR [N]}" n="${2:-20}"
  summarize "$run/events.jsonl" items "$n"
}

watch_run() {
  local run="${1:?usage: claude-task watch RUN_DIR [INTERVAL_S] [STALL_S]}"
  local interval="${2:-120}" stall="${3:-600}"
  [[ -d "$run" && -f "$run/meta.env" ]] || die "watch: '$run' is not a run directory"
  local start; start="$(meta_get "$run" START)"
  [[ "$start" =~ ^[0-9]+$ ]] || die "watch: missing or invalid START"
  local grace=$(( $(date +%s) + 2 ))
  while :; do
    if [[ -f "$run/exit_code" ]]; then
      echo "DONE exit=$(cat "$run/exit_code") $(summarize "$run/events.jsonl" last)"
      return 0
    fi
    local pid; pid="$(cat "$run/pid" 2>/dev/null)"
    if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
      if (( $(date +%s) >= grace )); then
        echo "DONE exit=unknown (no worker pid) $(summarize "$run/events.jsonl" last)"
        return 1
      fi
      sleep .1
      continue
    elif ! kill -0 "$pid" 2>/dev/null && [[ ! -f "$run/exit_code" ]]; then
      sleep 2
      [[ -f "$run/exit_code" ]] && continue
      echo "DONE exit=unknown (process gone, no exit_code) $(summarize "$run/events.jsonl" last)"
      return 1
    fi
    local now age; now="$(date +%s)"
    age=$((now - $(stat -c %Y "$run/events.jsonl" 2>/dev/null || echo "$now")))
    if ((age >= stall)); then
      echo "STALL no new events for $(fmt_secs "$age") elapsed=$(fmt_secs $((now - start)))"
    else
      echo "HB elapsed=$(fmt_secs $((now - start))) $(summarize "$run/events.jsonl" last)"
    fi
    sleep "$interval"
  done
}

list_runs() {
  local n="${1:-15}" run
  while IFS= read -r run; do
    run="${run%/}"
    [[ -d "$run" ]] || continue
    local display_model display_effort
    display_model="$(meta_get "$run" MODEL)"; display_effort="$(meta_get "$run" EFFORT)"
    local rc; rc="$(cat "$run/exit_code" 2>/dev/null || echo running)"
    printf '%-48s %-7s %-22s exit=%-7s %s\n' "$(basename "$run")" "$(meta_get "$run" KIND)" \
      "$display_model${display_effort:+/$display_effort}" "$rc" \
      "$(grep -m1 '^STATUS:' "$run/last.md" 2>/dev/null)"
  done < <(printf '%s\n' "$RUNS_ROOT"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-claude-*/ | sort | tail -n "$n")
}

case "${1:-}" in
  run | resume | review) kind="$1"; shift; launch "$kind" "$@" ;;
  peek) shift; peek "$@" ;;
  watch) shift; watch_run "$@" ;;
  ls) shift; list_runs "$@" ;;
  -h | --help | "") sed -n '2,/^set /{ /^set /!p; }' "$0" ;;
  *) die "unknown subcommand '$1' (run|resume|review|peek|watch|ls)" ;;
esac
